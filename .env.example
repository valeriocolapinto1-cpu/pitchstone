# Supabase (GitHub Secrets per il keep-alive; la chiave anon è pubblica per progetto)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Worker ai-proxy (secret Cloudflare: wrangler secret put <NOME>)
GEMINI_API_KEY=
SUPABASE_SECRET_KEY=

# Worker ai-proxy, valori pubblici in wrangler.toml [vars]
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Cloudflare Access service token (solo nel Keychain dell'iPad)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
