# Supabase (GitHub Secrets per il keep-alive; la chiave anon è pubblica per progetto)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Worker ai-proxy (secret Cloudflare: wrangler secret put GEMINI_API_KEY)
GEMINI_API_KEY=

# Cloudflare Access service token (solo nel Keychain dell'iPad)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
